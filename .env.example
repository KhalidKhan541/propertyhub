# PropertyHub Environment Variables
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_NAME=PropertyHub
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (when ready)
# DATABASE_URL="postgresql://user:password@localhost:5432/propertyhub"

# Authentication (when ready)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here

# MLS Integration
# MLS_API_KEY=
# MLS_API_URL=

# Maps
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Email
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Storage
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Analytics
# NEXT_PUBLIC_GA_ID=
